#!/usr/bin/env bash

# Thin stdio-to-HTTP proxy for MCP.
# Claude Code spawns this, sends JSON-RPC on stdin, gets responses on stdout.
# Forwards everything to the running watcher's MCP HTTP endpoint.
#
# If the watcher isn't running:
#   - initialize/ping/tools/list are answered by the proxy itself (so Claude
#     considers the MCP connected) — these never start a watcher, since Claude
#     Code spawns this proxy for every session, Elixir project or not.
#   - tools/call starts the watcher first (see ensure_watcher), then forwards.
#     If it can't be started, the call fails with a tool error — tests are never
#     run around the watcher. A broken watcher means: fix it or disable the MCP.

CONFIG_FILE=".polyglot_watcher_v2/config.json"

# Read MCP URL from config file written by the watcher
read_mcp_url() {
  if [ -f "$CONFIG_FILE" ]; then
    local port
    port=$(jq -r '.mcp_tcp_port // empty' "$CONFIG_FILE" 2>/dev/null)
    if [ -n "$port" ]; then
      echo "http://localhost:${port}/mcp"
      return 0
    fi
  fi
  return 1
}

MCP_URL=""
if url=$(read_mcp_url); then
  MCP_URL="$url"
fi

LOG="/tmp/mcp_stdio_proxy.log"

echo "--- proxy started at $(date) ---" >> "$LOG"
echo "CWD=$(pwd)" >> "$LOG"
echo "MCP_URL=$MCP_URL" >> "$LOG"

# Extract the "id" field from a JSON-RPC request (integer or string)
extract_id() {
  echo "$1" | sed -n 's/.*"id" *: *\([0-9]*\).*/\1/p'
}

# Extract the "method" field from a JSON-RPC request
extract_method() {
  echo "$1" | sed -n 's/.*"method" *: *"\([^"]*\)".*/\1/p'
}

# Fallback responses when the watcher is not running
fallback_initialize() {
  local id="$1"
  cat <<EOJSON
{"jsonrpc":"2.0","id":${id},"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"polyglot-watcher","version":"0.1.0"}}}
EOJSON
}

# Keep this list in sync with PolyglotWatcherV2.MCP.Handler's tools/list response.
# Calls to these tools start the watcher on demand, so offline they behave the
# same as online (just slower on the first call).
fallback_tools_list() {
  local id="$1"
  cat <<EOJSON
{"jsonrpc":"2.0","id":${id},"result":{"tools":[{"name":"mix_test","description":"MANDATORY: You MUST use this tool instead of running \`mix test\` via the shell. Never run \`mix test\` directly — always call this tool. Runs the specified Elixir test(s) and returns the output. If the same test is already running (e.g. triggered by a file save), waits for that run to finish and returns its result instead of running again.","inputSchema":{"type":"object","properties":{"test_path":{"type":"string","description":"Test file path to run, e.g. \"test/my_test.exs\". Omit to run all tests."},"line_number":{"type":"integer","description":"Optional line number to run a specific test, e.g. 42 for test/my_test.exs:42."},"extra_args":{"type":"array","items":{"type":"string"},"description":"Optional extra flags to pass to \`mix test\`, e.g. [\"--slowest\", \"5\"]. Only use for ad-hoc diagnostics — when present, the watcher does NOT serve a cached result or de-dup against an in-flight run (failures are still recorded), and unrecognized flags are treated as worst-case for cache safety."}}}},{"name":"mix_test_known_failures","description":"Returns failing tests captured in the watcher's in-memory cache from prior \`mix_test\` runs. Does NOT scan the project — tests that haven't been executed in this session won't appear. If the cache is empty, run \`mix_test\` first to populate it.","inputSchema":{"type":"object","properties":{}}}]}}
EOJSON
}

fallback_ping() {
  local id="$1"
  echo "{\"jsonrpc\":\"2.0\",\"id\":${id},\"result\":{}}"
}

fallback_error() {
  local id="$1"
  echo "{\"jsonrpc\":\"2.0\",\"id\":${id},\"error\":{\"code\":-32000,\"message\":\"Watcher is not running.\"}}"
}

# A tools/call result flagged isError, so Claude sees the message.
# $1=id $2=message
tool_error_response() {
  python3 -c "
import json, sys
print(json.dumps({'jsonrpc': '2.0', 'id': int(sys.argv[1]),
                  'result': {'content': [{'type': 'text', 'text': sys.argv[2]}], 'isError': True}}))
" "$1" "$2"
}

# Add a watcher_note to a forwarded tools/call response's JSON payload
# (result.content[0].text). Leaves the response untouched if it isn't shaped
# that way. $1=response $2=note
add_watcher_note() {
  python3 -c "
import json, sys
response, note = sys.argv[1], sys.argv[2]
try:
    msg = json.loads(response)
    content = msg['result']['content'][0]
    payload = json.loads(content['text'])
    payload['watcher_note'] = note
    content['text'] = json.dumps(payload)
    print(json.dumps(msg))
except Exception:
    print(response)
" "$1" "$2"
}

extract_tool_name() {
  echo "$1" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('params',{}).get('name',''))" 2>/dev/null
}

WATCHER_LOG=".polyglot_watcher_v2/watcher.log"
START_LOCK=".polyglot_watcher_v2/start_watcher.lock"
# Minutes of inactivity after which a watcher this proxy spawned detached shuts
# itself down. Only detached spawns get it — a watcher in a visible split (or
# started from the CLI) never idle-shuts-down.
IDLE_SHUTDOWN_MINUTES="${POLYGLOT_WATCHER_IDLE_SHUTDOWN_MINUTES:-30}"

# POST an MCP ping to the given URL; succeeds iff the watcher answers.
ping_watcher() {
  curl -s --max-time 2 -X POST "$1" \
    -H 'Content-Type: application/json' \
    -d '{"jsonrpc":"2.0","id":0,"method":"ping"}' 2>/dev/null | grep -q '"result"'
}

# Forward a request to MCP_URL. Echoes the response; fails if the watcher
# couldn't be reached or gave an empty reply (e.g. it died mid-request).
# tools/call gets no overall time limit: test runs can take minutes, and
# timing out would make us treat a busy watcher as a dead one.
forward() {
  local line="$1" max_time="$2" response
  [ -n "$MCP_URL" ] || return 1
  response=$(curl -s --connect-timeout 2 ${max_time:+--max-time "$max_time"} -X POST "$MCP_URL" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json' \
    -d "$line" 2>/dev/null) || return 1
  [ -n "$response" ] || return 1
  echo "$response"
}

# Spawn the launcher fully detached: new session (survives proxy death and
# group signals), stdin from /dev/null (the watcher handles :eof by simply not
# listening for user commands), output appended to WATCHER_LOG so the proxy's
# MCP stdout stays clean. Echoes the spawned OS pid.
spawn_watcher_detached() {
  POLYGLOT_WATCHER_IDLE_SHUTDOWN_MINUTES="$IDLE_SHUTDOWN_MINUTES" python3 -c "
import subprocess, sys
with open(sys.argv[2], 'ab') as log:
    p = subprocess.Popen([sys.argv[1]], stdin=subprocess.DEVNULL, stdout=log,
                         stderr=log, start_new_session=True)
print(p.pid)
" "$1" "$WATCHER_LOG"
}

# Make sure a watcher is up for this project, starting one if needed.
# Sets ENSURE_STARTED=true if this call started (or waited for another
# session's start of) a watcher, and ENSURE_ERROR to a message on failure.
# NOTE: must be called directly (not via $(...)) so its variable updates
# persist in the main loop's shell.
ensure_watcher() {
  ENSURE_STARTED=false
  ENSURE_ERROR=""
  local url

  if url=$(read_mcp_url) && ping_watcher "$url"; then
    MCP_URL="$url"
    return 0
  fi

  if [ ! -f mix.exs ]; then
    ENSURE_ERROR="Cannot start the polyglot watcher: no mix.exs in $(pwd) — run from an Elixir project root."
    echo "ENSURE: $ENSURE_ERROR" >> "$LOG"
    return 1
  fi

  # Locate the launcher script (sibling of this proxy script) and its release
  local proxy_dir launcher release_bin
  proxy_dir="$(dirname "$(readlink -f "$0")")"
  launcher="$proxy_dir/polyglot_watcher_v2"
  release_bin="$proxy_dir/_build/prod/rel/polyglot_watcher_v2/bin/polyglot_watcher_v2"
  if [ ! -x "$launcher" ] || [ ! -x "$release_bin" ]; then
    ENSURE_ERROR="Cannot start the polyglot watcher: launcher or release binary not found in $proxy_dir. Run ./build there first, or disable the polyglot-watcher MCP."
    echo "ENSURE: $ENSURE_ERROR" >> "$LOG"
    return 1
  fi

  mkdir -p .polyglot_watcher_v2

  # Clear a stale start lock (older than 60s)
  if [ -d "$START_LOCK" ]; then
    local now lock_mtime
    now=$(date +%s)
    lock_mtime=$(stat -f %m "$START_LOCK" 2>/dev/null || stat -c %Y "$START_LOCK" 2>/dev/null || echo 0)
    if [ $((now - lock_mtime)) -gt 60 ]; then
      echo "ENSURE: removing stale lock" >> "$LOG"
      rmdir "$START_LOCK" 2>/dev/null
    fi
  fi

  # Single-start guard: mkdir is atomic. If the lock is held, another session
  # is mid-start — don't spawn a second watcher, just wait for theirs.
  local spawned_pid="" spawned=false
  if mkdir "$START_LOCK" 2>/dev/null; then
    # POLYGLOT_WATCHER_SPAWN_CMD (affects this MCP path only — never the CLI):
    # a command prefix that receives the launcher path as its final argument,
    # e.g. a script that opens a tmux split, so a human can watch the tests
    # run live. Non-zero exit (not inside tmux, etc.) falls back to the
    # detached spawn below. Visible watchers never idle-shutdown.
    if [ -n "${POLYGLOT_WATCHER_SPAWN_CMD:-}" ]; then
      echo "ENSURE: spawning via POLYGLOT_WATCHER_SPAWN_CMD ($POLYGLOT_WATCHER_SPAWN_CMD)" >> "$LOG"
      if (unset POLYGLOT_WATCHER_IDLE_SHUTDOWN_MINUTES
          eval "$POLYGLOT_WATCHER_SPAWN_CMD $(printf '%q' "$launcher")") >> "$LOG" 2>&1; then
        spawned=true
      else
        echo "ENSURE: spawn cmd failed — falling back to detached spawn" >> "$LOG"
      fi
    fi
    if [ "$spawned" = false ]; then
      echo "ENSURE: spawning $launcher (detached, idle shutdown after ${IDLE_SHUTDOWN_MINUTES} min)" >> "$LOG"
      spawned_pid=$(spawn_watcher_detached "$launcher")
      spawned=true
      echo "ENSURE: spawned pid=$spawned_pid" >> "$LOG"
    fi
  else
    echo "ENSURE: lock held — waiting for another session's start" >> "$LOG"
  fi

  # Poll for readiness: up to 30s (120 * 0.25s)
  local ready=false i
  for i in $(seq 1 120); do
    if url=$(read_mcp_url) && ping_watcher "$url"; then
      MCP_URL="$url"
      ready=true
      break
    fi
    # Fail fast if the process we spawned died before becoming ready
    if [ -n "$spawned_pid" ] && ! kill -0 "$spawned_pid" 2>/dev/null; then
      echo "ENSURE: spawned pid $spawned_pid died before ready" >> "$LOG"
      break
    fi
    sleep 0.25
  done

  [ "$spawned" = true ] && rmdir "$START_LOCK" 2>/dev/null

  if [ "$ready" = true ]; then
    ENSURE_STARTED=true
    echo "ENSURE: ready ($MCP_URL)" >> "$LOG"
    return 0
  fi

  ENSURE_ERROR="The polyglot watcher did not become ready within 30s. Fix it, or disable the polyglot-watcher MCP. Last lines of $(pwd)/$WATCHER_LOG:
$(tail -n 30 "$WATCHER_LOG" 2>/dev/null)"
  echo "ENSURE: failed to become ready" >> "$LOG"
  return 1
}

# Handle a tools/call: make sure the watcher is up (starting it if needed),
# then forward. Sets TOOL_RESPONSE to the JSON-RPC response.
# NOTE: must be called directly (not via $(...)) so MCP_URL updates persist.
handle_tool_call() {
  local line="$1" id="$2" started=false

  if ! ensure_watcher; then
    TOOL_RESPONSE=$(tool_error_response "$id" "$ENSURE_ERROR")
    return
  fi
  [ "$ENSURE_STARTED" = true ] && started=true

  if ! TOOL_RESPONSE=$(forward "$line" ""); then
    # The watcher went away between the readiness check and the request (e.g.
    # it was idle-shutting-down at that moment) — start it again and retry once.
    echo "TOOL_CALL: forward failed — re-ensuring watcher and retrying" >> "$LOG"
    if ! ensure_watcher; then
      TOOL_RESPONSE=$(tool_error_response "$id" "$ENSURE_ERROR")
      return
    fi
    [ "$ENSURE_STARTED" = true ] && started=true
    if ! TOOL_RESPONSE=$(forward "$line" ""); then
      TOOL_RESPONSE=$(tool_error_response "$id" \
        "The polyglot watcher is running but the request to it failed. See $(pwd)/$WATCHER_LOG.")
      return
    fi
  fi

  if [ "$started" = true ]; then
    TOOL_RESPONSE=$(add_watcher_note "$TOOL_RESPONSE" \
      "The watcher wasn't running, so it was started automatically for this call. Its in-memory failure cache starts empty.")
  fi
}

while IFS= read -r line; do
  # Skip empty lines
  [ -z "$line" ] && continue

  echo "RECV: $line" >> "$LOG"

  # If we have no URL yet, try reading config
  if [ -z "$MCP_URL" ]; then
    if url=$(read_mcp_url); then
      MCP_URL="$url"
      echo "DISCOVERED: $MCP_URL" >> "$LOG"
    fi
  fi

  # Check if it's a notification (no "id" field) - we don't need the response
  if ! echo "$line" | grep -q '"id"'; then
    if [ -n "$MCP_URL" ]; then
      curl -s -o /dev/null --max-time 2 -X POST "$MCP_URL" \
        -H 'Content-Type: application/json' \
        -d "$line" 2>/dev/null
    fi
    echo "NOTIF: (no response)" >> "$LOG"
    continue
  fi

  req_id=$(extract_id "$line")
  method=$(extract_method "$line")

  if [ "$method" = "tools/call" ]; then
    handle_tool_call "$line" "$req_id"
    echo "SEND: $TOOL_RESPONSE" >> "$LOG"
    echo "$TOOL_RESPONSE"
    continue
  fi

  # Anything else - forward to the watcher if it's up
  sent=false
  if response=$(forward "$line" 30); then
    sent=true
  elif new_url=$(read_mcp_url) && [ "$new_url" != "$MCP_URL" ]; then
    # Watcher restarted on a new port
    MCP_URL="$new_url"
    echo "RETRY: new URL=$MCP_URL" >> "$LOG"
    response=$(forward "$line" 30) && sent=true
  fi

  # Watcher is not reachable - answer what we can ourselves (never starts one)
  if [ "$sent" = false ]; then
    echo "FALLBACK ($method): watcher unreachable" >> "$LOG"

    case "$method" in
      initialize) response=$(fallback_initialize "$req_id") ;;
      ping) response=$(fallback_ping "$req_id") ;;
      tools/list) response=$(fallback_tools_list "$req_id") ;;
      *) response=$(fallback_error "$req_id") ;;
    esac
  fi

  echo "SEND: $response" >> "$LOG"
  echo "$response"
done

echo "--- proxy exited at $(date) ---" >> "$LOG"
